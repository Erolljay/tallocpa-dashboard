# Copy to .env.local and fill in from the Supabase project (Singapore region).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server only, for the nightly job's caller check (any long random string).
CRON_SECRET=
# Server only. Gemini API key on the PAID tier (the free tier may use data for training). OCR is off without it.
GEMINI_API_KEY=
# Optional: Gemini model for OCR (default gemini-3.8-flash). Compare Flash and Pro on real receipts (spec open item O4).
GEMINI_MODEL=
# Optional: second model OCR tries when the main one is busy (default gemini-2.5-flash; empty string turns it off).
GEMINI_FALLBACK_MODEL=
# Optional: email for the monthly document requests and reminders (Resend). Without them, requests show in the portal only.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "Tallo CPA <documents@tallocpa.com>".
EMAIL_FROM=
# Optional: the eSubmission mailbox (Gmail API, docs/SETUP.md). Without them, staff send DAT files by hand and mark them sent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ESUBMISSION_GMAIL_REFRESH_TOKEN=
# Optional overrides (defaults attachments@tallocpa.com and esubmission@bir.gov.ph).
ESUBMISSION_MAILBOX=
ESUBMISSION_TO=
