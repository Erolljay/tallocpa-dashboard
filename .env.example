# Copy to .env.local and fill in from the Supabase project (Singapore region).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server only, for the nightly job's caller check (any long random string).
CRON_SECRET=
# Server only. Gemini API key on the PAID tier (the free tier may use data for training). OCR is off without it.
GEMINI_API_KEY=
# Optional: Gemini model for OCR (default gemini-3.8-flash). Compare Flash and Pro on real receipts (spec open item O4).
GEMINI_MODEL=
# Optional: second model OCR tries when the main one is busy (default gemini-2.5-flash; empty string turns it off).
GEMINI_FALLBACK_MODEL=
