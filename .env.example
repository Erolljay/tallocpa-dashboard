# Copy to .env.local and fill in from the Supabase project (Singapore region).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server only, for the nightly job's caller check (any long random string).
CRON_SECRET=
# Server only. Gemini API key on the PAID tier (the free tier may use data for training). OCR is off without it.
GEMINI_API_KEY=
# Optional: Gemini model for OCR (default gemini-3.8-flash). Compare Flash and Pro on real receipts (spec open item O4).
GEMINI_MODEL=
# Optional: second model OCR tries when the main one is busy (default gemini-2.5-flash; empty string turns it off).
GEMINI_FALLBACK_MODEL=
# Optional: email for the monthly document requests and reminders (Resend). Without them, requests show in the portal only.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "Tallo CPA <documents@tallocpa.com>".
EMAIL_FROM=
# Optional: the eSubmission mailbox (Gmail API, docs/SETUP.md). Without them, staff send DAT files by hand and mark them sent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ESUBMISSION_GMAIL_REFRESH_TOKEN=
# Optional overrides (defaults attachments@tallocpa.com and esubmission@bir.gov.ph).
ESUBMISSION_MAILBOX=
ESUBMISSION_TO=
# Optional: the mailbox where the banks' payment confirmations arrive (Payment Proof Clerk; docs/SETUP.md).
# A refresh token with scope gmail.readonly; without it the eSubmission mailbox above is read.
PAYMENT_MAIL_GMAIL_REFRESH_TOKEN=
PAYMENT_MAILBOX=
# Days back to look (default 14, at most 90).
PAYMENT_MAIL_DAYS=
# Optional: Google Calendar (team calendar, booking pages; docs/SETUP.md). Uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
# 32 random bytes, base64 (openssl rand -base64 32): encrypts the staff refresh tokens.
GOOGLE_TOKEN_KEY=
# Optional: the app's address for the OAuth redirect (default: the request's host), and the Workspace domain (default tallocpa.com).
APP_URL=
GOOGLE_WORKSPACE_DOMAIN=
# Optional: Telegram uploads (docs/SETUP.md). Off for every client until staff switch it on for that client.
TELEGRAM_BOT_TOKEN=
# The bot's username without @, e.g. TalloCPABot.
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it with every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Optional: the AI employees' connector (docs/SETUP.md). The session pooler connection string, server only.
SUPABASE_DB_URL=
# Supabase's root certificate (Database settings → SSL configuration), so the server is verified.
SUPABASE_DB_CA=
